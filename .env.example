# Bu faylın adını .env olaraq dəyişdirin və öz açarlarınızı yazın

# ===== AI beyin seçimi =====
# "gemini"  -> Google AI Studio (PULSUZ gündəlik limit) - tövsiyə olunan başlanğıc
# "claude"  -> Anthropic Claude API (ödənişli, daha güclü)
AI_PROVIDER=gemini

# Google AI Studio açarı (pulsuz): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=AIza...
# Vergüllə ayrılmış siyahı: birincinin limiti dolanda avtomatik növbətiyə keçilir
GEMINI_MODEL=gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Anthropic açarı (yalnız AI_PROVIDER=claude olduqda lazımdır): console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# ===== Telegram =====
# Telegram-da @BotFather ilə /newbot yazaraq alınır
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Öz Telegram ID-niz (@userinfobot-a yazıb öyrənə bilərsiniz).
# Bot yalnız bu istifadəçinin əmrlərini qəbul edəcək.
TELEGRAM_ADMIN_ID=123456789

# ===== Gündəlik avtomatik postlar =====
# Hər gün neçə post hazırlanacaq və saat neçədə (yerli vaxt)
DAILY_POST_COUNT=5
DAILY_POST_TIME=09:00
TIMEZONE=Asia/Baku

# Hazır post şəkilləri neçə gün saxlanılsın (disk dolmasın deyə).
# 0 yazılsa təmizləmə söndürülür.
OUTPUT_RETENTION_DAYS=30
